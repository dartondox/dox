# https://dart.dev/guides/libraries/private-files
# Created by `dart pub`
.dart_tool/
.DS_Store
bin/server
.docker
pubspec_overrides.yaml
.idea
site
.env
pubspec.yaml.backup

# Pub workspace: one pubspec.lock at the root. No lock files in packages.
packages/*/pubspec.lock

# `dart build cli` / `dox build` output
build/
.design-screenshots/

# examples/ use the local packages through their pubspec_overrides.yaml
!examples/*/pubspec_overrides.yaml
examples/*/pubspec.lock

# python cache of the docs hooks
__pycache__/

# IDE project files (IntelliJ / melos)
*.iml

# test coverage output
coverage/
