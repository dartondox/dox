APP_NAME=my_app
APP_ENV=development
APP_PORT=3000
APP_KEY=
APP_URL=http://localhost:3000

CACHE_STORE=file
STORAGE_DISK=local

# SQLite needs no setup. The file is created at the first start.
DB_CONNECTION=sqlite
DB_NAME=storage/app.sqlite

# A database url. When it is set, it wins over the DB_* keys.
# DATABASE_URL=postgres://user:pass@localhost:5432/dox

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
